      <ownedRepresentationDescriptors xmi:type="viewpoint:DRepresentationDescriptor" uid="_hYVcYCK1EfCxN8ZT_GmQhA" documentation="&lt;h2 style=&quot;margin: 29.03px 0px 19.35px; color: rgb(0, 0, 0); text-transform: none; line-height: 1; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 24.19px; font-style: normal; font-weight: 500; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); scroll-margin-top: 29.0304px; font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>Diagram: [OAB] 2.1.1.4 SE System Analysis Processes C1L5 (SYSML V1) - Refine Swimlanes&lt;/h2>&#xA;&#xA;&lt;p style=&quot;margin: 0px 0px 1em; text-align: left; color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>&lt;strong style=&quot;font-weight: bold;&quot;>Setting:&lt;/strong>&lt;span>&amp;nbsp;&lt;/span>System Analysis Phase&lt;/p>&#xA;&#xA;&lt;p style=&quot;margin: 0px 0px 1em; text-align: left; color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>This diagram is set in the System Analysis phase of the ARCADIA methodology. It focuses on configuring the System Analysis (SA) model by refining how use cases are enacted using swimlane diagrams.&lt;/p>&#xA;&#xA;&lt;h3 style=&quot;margin: 24.19px 0px 16.12px; color: rgb(0, 0, 0); text-transform: none; line-height: 1; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 20.16px; font-style: normal; font-weight: 500; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); scroll-margin-top: 24.192px; font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>Operational Process Description&lt;/h3>&#xA;&#xA;&lt;ul style=&quot;color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; padding-left: 2em; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; margin-bottom: 1em; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>&#xA;&#x9;&lt;li>&lt;strong style=&quot;font-weight: bold;&quot;>Owner:&lt;/strong>&lt;span>&amp;nbsp;&lt;/span>System Engineer&lt;/li>&#xA;&#x9;&lt;li>&lt;strong style=&quot;font-weight: bold;&quot;>Involved Activities:&lt;/strong>&#xA;&#x9;&lt;ul style=&quot;list-style: square; padding-left: 2em; margin-bottom: 0px;&quot;>&#xA;&#x9;&#x9;&lt;li>Configure SA Model&lt;/li>&#xA;&#x9;&#x9;&lt;li>Refine how the Use Case is Delivered with Swimlanes (ACTD)&lt;/li>&#xA;&#x9;&lt;/ul>&#xA;&#x9;&lt;/li>&#xA;&#x9;&lt;li>&lt;strong style=&quot;font-weight: bold;&quot;>Functional Exchanges:&lt;/strong>&#xA;&#x9;&lt;ul style=&quot;list-style: square; padding-left: 2em; margin-bottom: 0px;&quot;>&#xA;&#x9;&#x9;&lt;li>Functional Chains&lt;/li>&#xA;&#x9;&#x9;&lt;li>Scenarios&lt;/li>&#xA;&#x9;&#x9;&lt;li>MCB Elements&lt;/li>&#xA;&#x9;&#x9;&lt;li>Functions and Exchanges&lt;/li>&#xA;&#x9;&#x9;&lt;li>SAB Elements&lt;/li>&#xA;&#x9;&#x9;&lt;li>Interaction 185&lt;/li>&#xA;&#x9;&#x9;&lt;li>BDD&lt;/li>&#xA;&#x9;&#x9;&lt;li>UCs&lt;/li>&#xA;&#x9;&#x9;&lt;li>Activitt&lt;/li>&#xA;&#x9;&lt;/ul>&#xA;&#x9;&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;h2 style=&quot;margin: 29.03px 0px 19.35px; color: rgb(0, 0, 0); text-transform: none; line-height: 1; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 24.19px; font-style: normal; font-weight: 500; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); scroll-margin-top: 29.0304px; font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>Diagram: SA - Refine Swimlanes for System (V1)&lt;/h2>&#xA;&#xA;&lt;p style=&quot;margin: 0px 0px 1em; text-align: left; color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>&lt;strong style=&quot;font-weight: bold;&quot;>Setting:&lt;/strong>&lt;span>&amp;nbsp;&lt;/span>System Analysis Phase&lt;/p>&#xA;&#xA;&lt;p style=&quot;margin: 0px 0px 1em; text-align: left; color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>In this diagram, operational processes are detailed for refining system swimlanes, emphasizing the configuration and delivery of use cases using swimlanes.&lt;/p>&#xA;&#xA;&lt;h3 style=&quot;margin: 24.19px 0px 16.12px; color: rgb(0, 0, 0); text-transform: none; line-height: 1; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 20.16px; font-style: normal; font-weight: 500; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); scroll-margin-top: 24.192px; font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>Operational Process Description&lt;/h3>&#xA;&#xA;&lt;ul style=&quot;color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; padding-left: 2em; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; margin-bottom: 1em; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>&#xA;&#x9;&lt;li>&lt;strong style=&quot;font-weight: bold;&quot;>Owner:&lt;/strong>&lt;span>&amp;nbsp;&lt;/span>System Engineer&lt;/li>&#xA;&#x9;&lt;li>&lt;strong style=&quot;font-weight: bold;&quot;>Involved Activities:&lt;/strong>&#xA;&#x9;&lt;ul style=&quot;list-style: square; padding-left: 2em; margin-bottom: 0px;&quot;>&#xA;&#x9;&#x9;&lt;li>Configure SA Model&lt;/li>&#xA;&#x9;&#x9;&lt;li>Refine how the Use Case is Delivered with Swimlanes (ACTD)&lt;/li>&#xA;&#x9;&lt;/ul>&#xA;&#x9;&lt;/li>&#xA;&#x9;&lt;li>&lt;strong style=&quot;font-weight: bold;&quot;>Functional Exchanges:&lt;/strong>&#xA;&#x9;&lt;ul style=&quot;list-style: square; padding-left: 2em; margin-bottom: 0px;&quot;>&#xA;&#x9;&#x9;&lt;li>Activitt&lt;/li>&#xA;&#x9;&lt;/ul>&#xA;&#x9;&lt;/li>&#xA;&lt;/ul>&#xA;" name="[OAB] 2.1.1.4  SE System Analysis Processes C1L5 (SYSML V1) - Refince Swimlane" repPath="#_hYUOQCK1EfCxN8ZT_GmQhA" changeId="1757009035933">
