      <ownedRepresentationDescriptors xmi:type="viewpoint:DRepresentationDescriptor" uid="_afHM_lwIEeuksIAyCn6rwA" documentation="&lt;h2 style=&quot;margin: 14.51px 0px 19.35px; color: rgb(0, 0, 0); text-transform: none; line-height: 1; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 24.19px; font-style: normal; font-weight: 500; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); scroll-margin-top: 14.5152px; font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>Diagram Name: [OAB] 2.1 SE System Analysis Processes C1L5&lt;/h2>&#xA;&#xA;&lt;div class=&quot;section&quot; style=&quot;color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>&lt;strong style=&quot;font-weight: bold;&quot;>Setting in ARCADIA Method:&lt;/strong>&lt;span>&amp;nbsp;&lt;/span>This diagram is categorized under &amp;quot;Operational Activities&amp;quot;, focusing on system analysis processes within the context of the ARCADIA method.&lt;/div>&#xA;&#xA;&lt;div class=&quot;section&quot; style=&quot;color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>&lt;strong style=&quot;font-weight: bold;&quot;>Operational Processes Noted:&lt;/strong>&#xA;&#xA;&lt;div class=&quot;activity&quot;>&#xA;&lt;h3 style=&quot;margin: 12.09px 0px 16.12px; line-height: 1; font-size: 20.16px; font-style: normal; font-weight: 500; scroll-margin-top: 12.096px;&quot;>SA - Requirements Analysis&lt;/h3>&#xA;&lt;strong style=&quot;font-weight: bold;&quot;>Description:&lt;/strong>&lt;span>&amp;nbsp;&lt;/span>This process describes the activities related to gathering and analyzing system requirements. It typically begins with the activity &amp;quot;Particpate in Customer Requirment Gathering&amp;quot;, focusing on ensuring that the customer requirements are well-documented and understood.&lt;span>&amp;nbsp;&lt;/span>&lt;strong style=&quot;font-weight: bold;&quot;>Flow of Activities:&lt;/strong>&#xA;&#xA;&lt;ul style=&quot;padding-left: 2em; margin-bottom: 1em;&quot;>&#xA;&#x9;&lt;li>Particpate in Customer Requirment Gathering&lt;/li>&#xA;&#x9;&lt;li>Develop Customer Rerquirements&lt;/li>&#xA;&#x9;&lt;li>Review Scenarios&lt;/li>&#xA;&#x9;&lt;li>Develop Quality Attribute Requirements&lt;/li>&#xA;&#x9;&lt;li>Allocate Requirements to model&lt;/li>&#xA;&lt;/ul>&#xA;&lt;strong style=&quot;font-weight: bold;&quot;>Owner of Activities:&lt;/strong>&#xA;&#xA;&lt;ul style=&quot;padding-left: 2em; margin-bottom: 1em;&quot;>&#xA;&#x9;&lt;li>Particpate in Customer Requirment Gathering: Stakeholders, Customer, User, Marketing&lt;/li>&#xA;&#x9;&lt;li>Develop Customer Rerquirements: System Engineer&lt;/li>&#xA;&lt;/ul>&#xA;&lt;/div>&#xA;&#xA;&lt;div class=&quot;activity&quot;>&#xA;&lt;h3 style=&quot;margin: 12.09px 0px 16.12px; line-height: 1; font-size: 20.16px; font-style: normal; font-weight: 500; scroll-margin-top: 12.096px;&quot;>SA - Analyze and Verify&lt;/h3>&#xA;&lt;strong style=&quot;font-weight: bold;&quot;>Description:&lt;/strong>&lt;span>&amp;nbsp;&lt;/span>This process involves the validation of system analysis, ensuring that every part of the system fits the requirements. The process starts from allocating requirements to models and includes various reviews and developments that verify the system&amp;#39;s functionality and analysis.&lt;span>&amp;nbsp;&lt;/span>&lt;strong style=&quot;font-weight: bold;&quot;>Flow of Activities:&lt;/strong>&#xA;&#xA;&lt;ul style=&quot;padding-left: 2em; margin-bottom: 1em;&quot;>&#xA;&#x9;&lt;li>Allocate Requirements to model&lt;/li>&#xA;&#x9;&lt;li>Analysis and Verify System Analysis&lt;/li>&#xA;&#x9;&lt;li>Review System Functional Chain&lt;/li>&#xA;&#x9;&lt;li>Develop Functional Simulation of System&lt;/li>&#xA;&#x9;&lt;li>Review Execute Simulations Reports&lt;/li>&#xA;&lt;/ul>&#xA;&lt;strong style=&quot;font-weight: bold;&quot;>Owner of Activities:&lt;/strong>&#xA;&#xA;&lt;ul style=&quot;padding-left: 2em; margin-bottom: 1em;&quot;>&#xA;&#x9;&lt;li>Allocate Requirements to model: System Engineer&lt;/li>&#xA;&#x9;&lt;li>Analysis and Verify System Analysis: System Engineer&lt;/li>&#xA;&#x9;&lt;li>Develop Functional Simulation of System: System Engineer&lt;/li>&#xA;&lt;/ul>&#xA;&lt;/div>&#xA;&#xA;&lt;div class=&quot;activity&quot;>&#xA;&lt;h3 style=&quot;margin: 12.09px 0px 16.12px; line-height: 1; font-size: 20.16px; font-style: normal; font-weight: 500; scroll-margin-top: 12.096px;&quot;>SA - Perform System Analysis&lt;/h3>&#xA;&lt;strong style=&quot;font-weight: bold;&quot;>Description:&lt;/strong>&lt;span>&amp;nbsp;&lt;/span>The aim is to perform detailed system analysis, which includes functions allocation, understanding capabilities and missions, and operational process descriptions. It often begins with &amp;quot;Allocated Functions&amp;quot; that lead into system functionality analysis.&lt;span>&amp;nbsp;&lt;/span>&lt;strong style=&quot;font-weight: bold;&quot;>Flow of Activities:&lt;/strong>&#xA;&#xA;&lt;ul style=&quot;padding-left: 2em; margin-bottom: 1em;&quot;>&#xA;&#x9;&lt;li>Allocated Functions&lt;/li>&#xA;&#x9;&lt;li>Funtions&lt;/li>&#xA;&#x9;&lt;li>Entities,Capabilities, Missions&lt;/li>&#xA;&#x9;&lt;li>OPD&lt;/li>&#xA;&lt;/ul>&#xA;&lt;strong style=&quot;font-weight: bold;&quot;>Owner of Activities:&lt;/strong>&#xA;&#xA;&lt;ul style=&quot;padding-left: 2em; margin-bottom: 1em;&quot;>&#xA;&#x9;&lt;li>Allocated Functions: System Engineer&lt;/li>&#xA;&lt;/ul>&#xA;&lt;/div>&#xA;&lt;/div>&#xA;" name="[OAB] 2.1 SE System Analysis Processes C1L5" repPath="#_afHMQFwIEeuksIAyCn6rwA" changeId="1750863363902">
        <description xmi:type="description_1:DiagramDescription" href="platform:/plugin/org.polarsys.capella.core.sirius.analysis/description/oa.odesign#//@ownedViewpoints[name='Operational%20Analysis']/@ownedRepresentations[name='Operational%20Entity%20Blank']"/>
