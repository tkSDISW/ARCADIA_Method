      <ownedRepresentationDescriptors xmi:type="viewpoint:DRepresentationDescriptor" uid="_wczR0B_bEfCxN8ZT_GmQhA" documentation="&lt;h2 style=&quot;margin: 29.03px 0px 19.35px; color: rgb(0, 0, 0); text-transform: none; line-height: 1; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 24.19px; font-style: normal; font-weight: 500; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); scroll-margin-top: 29.0304px; font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>Diagram: [OAB] 2.1.1.2 SE System Analysis Processes C1L5 - Refine Actors and Mission Capabilities&lt;/h2>&#xA;&#xA;&lt;p style=&quot;margin: 0px 0px 1em; text-align: left; color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>This diagram is situated in the System Analysis phase of the ARCADIA method. It focuses on the refinement of actors and mission capabilities.&lt;/p>&#xA;&#xA;&lt;h3 style=&quot;margin: 24.19px 0px 16.12px; color: rgb(0, 0, 0); text-transform: none; line-height: 1; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 20.16px; font-style: normal; font-weight: 500; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); scroll-margin-top: 24.192px; font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>Operational Process: SA - Refine Actors and Mission Capabilities&lt;/h3>&#xA;&#xA;&lt;ul style=&quot;color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; padding-left: 2em; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; margin-bottom: 1em; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>&#xA;&#x9;&lt;li>&lt;strong style=&quot;font-weight: bold;&quot;>Owner:&lt;/strong>&lt;span>&amp;nbsp;&lt;/span>System Engineer&lt;/li>&#xA;&#x9;&lt;li>&lt;strong style=&quot;font-weight: bold;&quot;>Involved Activities:&lt;/strong>&#xA;&#x9;&lt;ul style=&quot;list-style: square; padding-left: 2em; margin-bottom: 0px;&quot;>&#xA;&#x9;&#x9;&lt;li>Refiine Actors and Entities, Missions and Capabilities [MCB]&lt;/li>&#xA;&#x9;&#x9;&lt;li>Configure Model&lt;/li>&#xA;&#x9;&#x9;&lt;li>Configure SA Model&lt;/li>&#xA;&#x9;&lt;/ul>&#xA;&#x9;&lt;/li>&#xA;&#x9;&lt;li>&lt;strong style=&quot;font-weight: bold;&quot;>Functional Exchanges Involved:&lt;/strong>&#xA;&#x9;&lt;ul style=&quot;list-style: square; padding-left: 2em; margin-bottom: 0px;&quot;>&#xA;&#x9;&#x9;&lt;li>MCB Elements&lt;/li>&#xA;&#x9;&lt;/ul>&#xA;&#x9;&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;p style=&quot;margin: 0px 0px 1em; text-align: left; color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>The operational process involves refining actors and entities, missions, and capabilities guided by the System Engineer. This refinement is supported by configuring models and scenarios within the SA (System Analysis) framework.&lt;/p>&#xA;" name="[OAB] 2.1.1.2  SE System Analysis Processes C1L5 - Refine Actors and Mission Capabilities" repPath="#_wcyDsB_bEfCxN8ZT_GmQhA" changeId="1762013605772">
        <description xmi:type="description_1:DiagramDescription" href="platform:/plugin/org.polarsys.capella.core.sirius.analysis/description/oa.odesign#//@ownedViewpoints[name='Operational%20Analysis']/@ownedRepresentations[name='Operational%20Entity%20Blank']"/>
        <target xmi:type="org.polarsys.capella.core.data.oa:EntityPkg" href="ARCADIA_Method.capella#b6c929f3-e9ce-47fe-9193-41a3b601dd36"/>
      </ownedRepresentationDescriptors>
      <ownedRepresentationDescriptors xmi:type="viewpoint:DRepresentationDescriptor" uid="_7zFNkB_bEfCxN8ZT_GmQhA" documentation="&lt;h2 style=&quot;margin: 29.03px 0px 19.35px; color: rgb(0, 0, 0); text-transform: none; line-height: 1; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 24.19px; font-style: normal; font-weight: 500; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); scroll-margin-top: 29.0304px; font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>Diagram: [OAB] 2.1.1.3 SE System Analysis Processes C1L5&lt;/h2>&#xA;&#xA;&lt;p style=&quot;margin: 0px 0px 1em; text-align: left; color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>This diagram pertains to the ARCADIA method, specifically the System Analysis phase. It involves refining and allocating system functions to actors, entities, and the system.&lt;/p>&#xA;&#xA;&lt;h3 style=&quot;margin: 24.19px 0px 16.12px; color: rgb(0, 0, 0); text-transform: none; line-height: 1; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 20.16px; font-style: normal; font-weight: 500; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); scroll-margin-top: 24.192px; font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>Operational Process: SA - Refine and Allocate System Functions to Actors, Entities and System&lt;/h3>&#xA;&#xA;&lt;p style=&quot;margin: 0px 0px 1em; text-align: left; color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>The operational process focuses on refining and allocating system functions, involving various activities and exchanges within the system:&lt;/p>&#xA;&#xA;&lt;ul style=&quot;color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; padding-left: 2em; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; margin-bottom: 1em; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>&#xA;&#x9;&lt;li>&lt;strong style=&quot;font-weight: bold;&quot;>Involved Activities:&lt;/strong>&#xA;&#xA;&#x9;&lt;ul style=&quot;list-style: square; padding-left: 2em; margin-bottom: 0px;&quot;>&#xA;&#x9;&#x9;&lt;li>Allocate System Functions to System and Actors [SAB]&lt;/li>&#xA;&#x9;&#x9;&lt;li>Refine System Functions, Describe Functional Exchanges [SDFB]&lt;/li>&#xA;&#x9;&#x9;&lt;li>Configure Model&lt;/li>&#xA;&#x9;&#x9;&lt;li>Configure SA Model&lt;/li>&#xA;&#x9;&lt;/ul>&#xA;&#x9;&lt;/li>&#xA;&#x9;&lt;li>&lt;strong style=&quot;font-weight: bold;&quot;>Functional Exchanges:&lt;/strong>&#xA;&#x9;&lt;ul style=&quot;list-style: square; padding-left: 2em; margin-bottom: 0px;&quot;>&#xA;&#x9;&#x9;&lt;li>System Functions&lt;/li>&#xA;&#x9;&#x9;&lt;li>Functions and Exchanges&lt;/li>&#xA;&#x9;&#x9;&lt;li>SAB Elements&lt;/li>&#xA;&#x9;&lt;/ul>&#xA;&#x9;&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;p style=&quot;margin: 0px 0px 1em; text-align: left; color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>&lt;strong style=&quot;font-weight: bold;&quot;>Owner of Activities:&lt;/strong>&lt;span>&amp;nbsp;&lt;/span>System Engineer. The System Engineer is responsible for executing these activities and overseeing the system processes.&lt;/p>&#xA;&#xA;&lt;h2 style=&quot;margin: 29.03px 0px 19.35px; color: rgb(0, 0, 0); text-transform: none; line-height: 1; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 24.19px; font-style: normal; font-weight: 500; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); scroll-margin-top: 29.0304px; font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>Diagram: SA - Refine System Functional Chains [SAB]&lt;/h2>&#xA;&#xA;&lt;p style=&quot;margin: 0px 0px 1em; text-align: left; color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>This diagram also belongs to the System Analysis phase within the ARCADIA method. It emphasizes the refinement of system functional chains and their allocation.&lt;/p>&#xA;&#xA;&lt;h3 style=&quot;margin: 24.19px 0px 16.12px; color: rgb(0, 0, 0); text-transform: none; line-height: 1; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 20.16px; font-style: normal; font-weight: 500; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); scroll-margin-top: 24.192px; font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>Operational Process: SA - Refine System Functional Chains [SAB]&lt;/h3>&#xA;&#xA;&lt;p style=&quot;margin: 0px 0px 1em; text-align: left; color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>This operational process involves refining the system functional chains through coordinated activities and exchanges:&lt;/p>&#xA;&#xA;&lt;ul style=&quot;color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; padding-left: 2em; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; margin-bottom: 1em; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>&#xA;&#x9;&lt;li>&lt;strong style=&quot;font-weight: bold;&quot;>Involved Activities:&lt;/strong>&#xA;&#xA;&#x9;&lt;ul style=&quot;list-style: square; padding-left: 2em; margin-bottom: 0px;&quot;>&#xA;&#x9;&#x9;&lt;li>Refine how the Capability or Mission is Delivered [SAB]&lt;/li>&#xA;&#x9;&#x9;&lt;li>Configure Model&lt;/li>&#xA;&#x9;&#x9;&lt;li>Define Interface and Interface Scenarios [CDI][CEI][IS}&lt;/li>&#xA;&#x9;&#x9;&lt;li>Configure SA Model&lt;/li>&#xA;&#x9;&lt;/ul>&#xA;&#x9;&lt;/li>&#xA;&#x9;&lt;li>&lt;strong style=&quot;font-weight: bold;&quot;>Functional Exchanges:&lt;/strong>&#xA;&#x9;&lt;ul style=&quot;list-style: square; padding-left: 2em; margin-bottom: 0px;&quot;>&#xA;&#x9;&#x9;&lt;li>Functional Chains (b9ee4c7b-61a2-4a74-b29c-7ea5947691ca)&lt;/li>&#xA;&#x9;&#x9;&lt;li>Functional Chains (325048fb-8d23-4893-a7a5-cdc16ffbb5fa)&lt;/li>&#xA;&#x9;&#x9;&lt;li>Interaction 185&lt;/li>&#xA;&#x9;&lt;/ul>&#xA;&#x9;&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;p style=&quot;margin: 0px 0px 0.5em; text-align: left; color: rgb(0, 0, 0); text-transform: none; text-indent: 0px; letter-spacing: normal; font-family: system-ui, -apple-system, blinkmacsystemfont, &amp;quot;Segoe UI&amp;quot;, helvetica, arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 14px; font-style: normal; font-weight: 400; word-spacing: 0px; white-space: normal; orphans: 2; widows: 2; background-color: rgb(255, 255, 255); font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;>&lt;strong style=&quot;font-weight: bold;&quot;>Owner of Activities:&lt;/strong>&lt;span>&amp;nbsp;&lt;/span>System Engineer. This role involves ensuring the proper execution and integration of the activities to achieve desired system functionalities.&lt;/p>&#xA;" name="[OAB] 2.1.1.3  SE System Analysis Processes C1L5 - Refine amd Allocate System Functions to Actors , Entites and System" repPath="#_7zD_cB_bEfCxN8ZT_GmQhA" changeId="1745682156317">
