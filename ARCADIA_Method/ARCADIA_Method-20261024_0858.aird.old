      <ownedRepresentationDescriptors xmi:type="viewpoint:DRepresentationDescriptor" uid="_7iNyAB8VEfCxN8ZT_GmQhA" documentation="&lt;p>Diagram: [OAB] 2.1.1.1 SE System Analysis Processes C1L5 (SYSML V1)&lt;br />&#xA;Setting: ARCADIA Method Context&lt;br />&#xA;This diagram involves the SE System Analysis Processes, as defined in SysML V1, offering a structured perspective on system engineering processes within the ARCADIA framework.&lt;/p>&#xA;&#xA;&lt;p>Operational Processes on Diagram&lt;br />&#xA;Operational Process: SA - Requirements Analysis&lt;br />&#xA;Description: This process entails gathering and analyzing customer requirements, allocating them to models, and defining scenarios and allocations.&lt;/p>&#xA;&#xA;&lt;p>Flow of Activities:&lt;/p>&#xA;&#xA;&lt;p>Start: Particpate in Customer Requirment Gathering (no input flow)&lt;br />&#xA;Activities:&lt;br />&#xA;Develop Customer Requirements&lt;br />&#xA;Review Scenarios&lt;br />&#xA;Develop Quality Attribute Requirements&lt;br />&#xA;Allocate Requirements to model&lt;br />&#xA;Owners:&lt;/p>&#xA;&#xA;&lt;p>Particpate in Customer Requirement Gathering: Stakeholders, Customer, User, Marketing&lt;br />&#xA;Operational Process: SA - Analyze and Verify&lt;br />&#xA;Description: This process focuses on verifying system analysis through functional simulations, reviewing system functional chains, and system interfaces.&lt;/p>&#xA;&#xA;&lt;p>Flow of Activities:&lt;/p>&#xA;&#xA;&lt;p>Start: Allocate Requirements to model (with input flow)&lt;br />&#xA;Activities:&lt;br />&#xA;Analysis and Verify System Analysis&lt;br />&#xA;Review System Functional Chain&lt;br />&#xA;Develop Functional Simulation of System&lt;br />&#xA;Review Execute Simulations Reports&lt;br />&#xA;Owners:&lt;/p>&#xA;&#xA;&lt;p>Analysis and Verify System Analysis: System Engineer&lt;br />&#xA;Review System Functional Chain: Stakeholders, Customer, User, Marketing&lt;br />&#xA;Operational Process: SA - Refine Actors and Entities (V1)&lt;br />&#xA;Description: Refines the understanding of actors and entities using BDD within the SA Model configuration.&lt;/p>&#xA;&#xA;&lt;p>Flow:&lt;/p>&#xA;&#xA;&lt;p>Start: Configure SA Model (with input flow)&lt;br />&#xA;Activities:&lt;br />&#xA;Refine Actors and Entities (BDD)&lt;br />&#xA;Owners:&lt;/p>&#xA;&#xA;&lt;p>Refine Actors and Entities (BDD): System Engineer&lt;/p>&#xA;" name=" " repPath="#_7iLVwB8VEfCxN8ZT_GmQhA" changeId="1751122005615">
        <description xmi:type="description_1:DiagramDescription" href="platform:/plugin/org.polarsys.capella.core.sirius.analysis/description/oa.odesign#//@ownedViewpoints[name='Operational%20Analysis']/@ownedRepresentations[name='Operational%20Entity%20Blank']"/>
        <target xmi:type="org.polarsys.capella.core.data.oa:EntityPkg" href="ARCADIA_Method.capella#b6c929f3-e9ce-47fe-9193-41a3b601dd36"/>
      </ownedRepresentationDescriptors>
